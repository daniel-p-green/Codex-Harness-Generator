{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Read(**)",
      "Edit(./Docs/**)",
      "Write(./Docs/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./CONTRIBUTING.md)",
      "Write(./CONTRIBUTING.md)",
      "Edit(./README.md)",
      "Write(./README.md)",
      "Edit(./examples/**)",
      "Write(./examples/**)",
      "WebSearch",
      "WebFetch(*)",
      "Write(**/.claude/**)",
      "Edit(**/.claude/**)",
      "Write(**/CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Write(**/.claudeignore)",
      "Edit(**/.claudeignore)",
      "Write(**/Docs/**)",
      "Edit(**/Docs/**)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(rm */.claude_env_write_test)",
      "Bash(touch *)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(pandoc *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(cat *)",
      "Bash(cp *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Write(**/nul)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)"
    ]
  }
}
